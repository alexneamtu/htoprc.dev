{
  "name": "htoprc-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "pnpm": {
    "overrides": {
      "undici": ">=7.18.2",
      "minimatch@<11.0.1": ">=11.0.1"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @htoprc/web --filter @htoprc/api run --parallel dev",
    "build": "pnpm run -r build",
    "test": "pnpm run -r test",
    "test:parser": "pnpm --filter @htoprc/parser test",
    "lint": "pnpm run -r lint",
    "typecheck": "pnpm run -r typecheck",
    "db:migrate": "pnpm --filter @htoprc/api db:migrate",
    "db:migrate:prod": "pnpm --filter @htoprc/api db:migrate:prod",
    "db:seed": "pnpm --filter @htoprc/api db:seed",
    "deploy": "pnpm run -r deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
